{
  "compatibilityLevel": 1606,
  "model": {
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"SourceFolder\",\"_Measures\",\"dim_airline\",\"dim_date\",\"dim_departure_date\",\"dim_booking_date\",\"dim_route\",\"dim_passenger\",\"dim_status\",\"fact_flight\",\"fact_booking\",\"fact_payment\",\"dq_issue_summary\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      }
    ],
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "SourceFolder",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ],
        "expression": "\"c:/Users/vishw/Downloads/Airlines Use Case simple/data/gold\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "kind": "m",
        "lineageTag": "e06f8b29-9d52-432b-a8f4-6572f6815205"
      }
    ],
    "relationships": [
      {
        "name": "rel_airline_flight",
        "fromColumn": "airline_sk",
        "fromTable": "fact_flight",
        "toColumn": "airline_sk",
        "toTable": "dim_airline"
      },
      {
        "name": "rel_route_flight",
        "fromColumn": "route_sk",
        "fromTable": "fact_flight",
        "toColumn": "route_sk",
        "toTable": "dim_route"
      },
      {
        "name": "rel_depdate_flight",
        "fromColumn": "departure_date_sk",
        "fromTable": "fact_flight",
        "toColumn": "date_sk",
        "toTable": "dim_departure_date"
      },
      {
        "name": "rel_flight_booking",
        "fromColumn": "flight_sk",
        "fromTable": "fact_booking",
        "toColumn": "flight_sk",
        "toTable": "fact_flight"
      },
      {
        "name": "rel_bookdate_booking",
        "fromColumn": "booking_date_sk",
        "fromTable": "fact_booking",
        "toColumn": "date_sk",
        "toTable": "dim_booking_date"
      },
      {
        "name": "rel_passenger_booking",
        "fromColumn": "passenger_sk",
        "fromTable": "fact_booking",
        "toColumn": "passenger_sk",
        "toTable": "dim_passenger"
      },
      {
        "name": "rel_status_booking",
        "fromColumn": "status_sk",
        "fromTable": "fact_booking",
        "toColumn": "status_sk",
        "toTable": "dim_status"
      },
      {
        "name": "rel_booking_payment",
        "fromColumn": "booking_sk",
        "fromTable": "fact_payment",
        "toColumn": "booking_sk",
        "toTable": "fact_booking"
      }
    ],
    "sourceQueryCulture": "en-IN",
    "tables": [
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "RowId",
            "dataType": "int64",
            "isHidden": true,
            "lineageTag": "b4c9941a-3645-4c90-ae95-4423b809431a",
            "sourceColumn": "RowId"
          }
        ],
        "lineageTag": "0b1c4c63-1d44-4664-9120-73ab0e55f83e",
        "measures": [
          {
            "name": "Flights",
            "description": "Total valid flight count excluding unknown placeholder surrogate -1",
            "expression": [
              "COALESCE(",
              "    CALCULATE(",
              "        COUNTROWS('fact_flight'),",
              "        KEEPFILTERS('fact_flight'[is_unknown_member] = FALSE())",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "a18a8009-7c13-4a4e-be1e-5c25c1d604aa"
          },
          {
            "name": "Average Duration Minutes",
            "description": "Average duration in minutes across valid flights",
            "expression": [
              "CALCULATE(",
              "    AVERAGE('fact_flight'[duration_minutes]),",
              "    KEEPFILTERS('fact_flight'[is_unknown_member] = FALSE())",
              ")"
            ],
            "formatString": "0.00",
            "lineageTag": "dc1f8cff-55a7-4e5b-b793-9a961a89814c"
          },
          {
            "name": "Duration Spread Minutes",
            "description": "Population standard deviation of duration minutes across valid flights",
            "expression": [
              "VAR FlightsWithDuration =",
              "    FILTER(",
              "        'fact_flight',",
              "        'fact_flight'[is_unknown_member] = FALSE()",
              "            && NOT ISBLANK('fact_flight'[duration_minutes])",
              "    )",
              "RETURN",
              "    SWITCH(",
              "        COUNTROWS(FlightsWithDuration),",
              "        0, BLANK(),",
              "        1, 0,",
              "        STDEVX.P(FlightsWithDuration, 'fact_flight'[duration_minutes])",
              "    )"
            ],
            "formatString": "0.00",
            "lineageTag": "d8fc4d58-70b5-4e99-a720-8636ad2581e7"
          },
          {
            "name": "Overnight Flights",
            "description": "Flights departing on one calendar day and arriving the next",
            "expression": "CALCULATE([Flights], KEEPFILTERS('fact_flight'[is_overnight] = TRUE()))",
            "formatString": "#,##0",
            "lineageTag": "a0e3367e-9ab0-4c1a-a091-43409c06a09a"
          },
          {
            "name": "Overnight Share",
            "description": "Share of flights that are overnight",
            "expression": "DIVIDE([Overnight Flights], [Flights])",
            "formatString": "0.0%",
            "lineageTag": "36bdf423-f7b5-4cac-889b-5928b58c9c12"
          },
          {
            "name": "Red Eye Flights",
            "description": "Flights departing between 22:00 and 05:00",
            "expression": "CALCULATE([Flights], KEEPFILTERS('fact_flight'[is_red_eye] = TRUE()))",
            "formatString": "#,##0",
            "lineageTag": "ccbbd3e7-cdbf-4ed0-b0b7-6d9d7e338ad3"
          },
          {
            "name": "Red Eye Share",
            "description": "Share of flights that depart during red-eye window",
            "expression": "DIVIDE([Red Eye Flights], [Flights])",
            "formatString": "0.0%",
            "lineageTag": "f85143f7-c87a-4525-90d7-19e6e12e92ca"
          },
          {
            "name": "Corrected Flights",
            "description": "Flights where negative duration was corrected by rolling arrival forward",
            "expression": "CALCULATE([Flights], KEEPFILTERS('fact_flight'[was_corrected] = TRUE()))",
            "formatString": "#,##0",
            "lineageTag": "b15256fd-8a70-4759-8e75-f692e0f98770"
          },
          {
            "name": "Airline Flight Share",
            "description": "Airline share of total flights across all airlines",
            "expression": [
              "DIVIDE(",
              "    [Flights],",
              "    CALCULATE([Flights], REMOVEFILTERS('dim_airline'))",
              ")"
            ],
            "formatString": "0.0%",
            "lineageTag": "e1da119d-1f75-483d-9d63-9d3cd06edfe9"
          },
          {
            "name": "Bookings",
            "description": "Total booking records",
            "expression": "COALESCE(COUNTROWS('fact_booking'), 0)",
            "formatString": "#,##0",
            "lineageTag": "686a262a-b6ca-4bd3-8e02-ab8620a1fbc8"
          },
          {
            "name": "Payments",
            "description": "Total payment records",
            "expression": "COALESCE(COUNTROWS('fact_payment'), 0)",
            "formatString": "#,##0",
            "lineageTag": "a2025810-1f79-476e-a0c1-f43bbc8f93ef"
          },
          {
            "name": "Gross Valid Payment Amount",
            "description": "Sum of valid payment amounts in INR",
            "expression": [
              "CALCULATE(",
              "    SUM('fact_payment'[amount]),",
              "    KEEPFILTERS('fact_payment'[amount_quality] = \"valid\")",
              ")"
            ],
            "formatString": "\"₹\"#,##0.00;(\"₹\"#,##0.00);\"₹\"0.00",
            "lineageTag": "7ff82347-cd9f-4d66-b766-0544512fef0e"
          },
          {
            "name": "Confirmed Booking Payment Amount",
            "description": "Gross valid payment amount filtered to confirmed bookings",
            "expression": [
              "CALCULATE(",
              "    [Gross Valid Payment Amount],",
              "    KEEPFILTERS('dim_status'[status] = \"CONFIRMED\")",
              ")"
            ],
            "formatString": "\"₹\"#,##0.00;(\"₹\"#,##0.00);\"₹\"0.00",
            "lineageTag": "6600acff-8447-4f59-8caa-9f92c66a2038"
          },
          {
            "name": "Cancelled Bookings",
            "description": "Count of cancelled bookings",
            "expression": "CALCULATE([Bookings], KEEPFILTERS('dim_status'[status] = \"CANCELLED\"))",
            "formatString": "#,##0",
            "lineageTag": "26ac4247-31ee-46be-9f3f-f663e0dcd992"
          },
          {
            "name": "Cancellation Rate",
            "description": "Cancelled bookings divided by total bookings",
            "expression": "DIVIDE([Cancelled Bookings], [Bookings])",
            "formatString": "0.0%",
            "lineageTag": "f1f2c054-6d10-464e-8521-cbc14f19e0e2"
          },
          {
            "name": "Confirmed Bookings",
            "description": "Count of confirmed bookings",
            "expression": "CALCULATE([Bookings], KEEPFILTERS('dim_status'[status] = \"CONFIRMED\"))",
            "formatString": "#,##0",
            "lineageTag": "ea871e06-7799-4209-a2b0-9514f19b4fbc"
          },
          {
            "name": "Confirmation Rate",
            "description": "Confirmed bookings divided by total bookings",
            "expression": "DIVIDE([Confirmed Bookings], [Bookings])",
            "formatString": "0.0%",
            "lineageTag": "d6630ed2-554a-464d-8baa-c57f251ec350"
          },
          {
            "name": "Bookings With Payment",
            "description": "Count of unique bookings with at least one payment record",
            "expression": "COALESCE(DISTINCTCOUNT('fact_payment'[booking_sk]), 0)",
            "formatString": "#,##0",
            "lineageTag": "af555ce2-2026-4e75-b4d3-c3c6684c5872"
          },
          {
            "name": "Payment Coverage",
            "description": "Share of bookings having any payment record",
            "expression": "DIVIDE([Bookings With Payment], [Bookings])",
            "formatString": "0.0%",
            "lineageTag": "cf2cf21d-b6f5-4e26-af74-17e74eccf770"
          },
          {
            "name": "Bookings With Valid Payment",
            "description": "Count of unique bookings with at least one valid payment record",
            "expression": [
              "COALESCE(",
              "    CALCULATE(",
              "        DISTINCTCOUNT('fact_payment'[booking_sk]),",
              "        KEEPFILTERS('fact_payment'[amount_quality] = \"valid\")",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "418623f9-9683-45d5-af75-95df8032cdfe"
          },
          {
            "name": "Average Valid Payment Per Paid Booking",
            "description": "Gross valid payments divided by paid bookings",
            "expression": "DIVIDE([Gross Valid Payment Amount], [Bookings With Valid Payment])",
            "formatString": "\"₹\"#,##0.00;(\"₹\"#,##0.00);\"₹\"0.00",
            "lineageTag": "734ee7fe-d502-4031-9d13-279dbf73cdef"
          },
          {
            "name": "Bookings Without Payment",
            "description": "Count of bookings with zero payment records",
            "expression": [
              "COALESCE(",
              "    COUNTROWS(",
              "        EXCEPT(",
              "            VALUES('fact_booking'[booking_sk]),",
              "            VALUES('fact_payment'[booking_sk])",
              "        )",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "85ad867e-45a2-4687-82f7-c82e8c7017af"
          },
          {
            "name": "Unresolved Flight Bookings",
            "description": "Bookings associated with surrogate -1 unknown flight",
            "expression": [
              "CALCULATE(",
              "    [Bookings],",
              "    KEEPFILTERS('fact_booking'[has_unresolved_flight] = TRUE())",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "4a43598f-d032-4e83-b725-1ce96bd164a7"
          },
          {
            "name": "Missing Amount Payments",
            "description": "Payments with missing / blank amount",
            "expression": "CALCULATE([Payments], KEEPFILTERS('fact_payment'[amount_quality] = \"missing\"))",
            "formatString": "#,##0",
            "lineageTag": "0eb4c2a3-9729-474a-a09a-a556b3662ffa"
          },
          {
            "name": "Invalid Amount Payments",
            "description": "Payments with non-numeric or negative amounts",
            "expression": [
              "CALCULATE(",
              "    [Payments],",
              "    KEEPFILTERS('fact_payment'[amount_quality] IN { \"non_numeric\", \"out_of_range\" })",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "7137ef0a-0386-4ef3-9454-70ee36089514"
          },
          {
            "name": "Source Issue Events",
            "description": "Sum of source issue events from disconnected dq_issue_summary",
            "expression": "COALESCE(SUM('dq_issue_summary'[affected_rows]), 0)",
            "formatString": "#,##0",
            "lineageTag": "7dec9ce3-3df0-40f9-a2eb-ebb0a39bed40"
          }
        ],
        "partitions": [
          {
            "name": "_Measures-Partition",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [RowId = _t]),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"RowId\", Int64.Type}})",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "dim_airline",
        "columns": [
          {
