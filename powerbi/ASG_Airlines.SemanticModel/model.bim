              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(SourceFolder & \"/dim_airline.csv\"), [Delimiter=\",\", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"airline_sk\", Int64.Type}, {\"airline\", type text}, {\"is_unknown\", type logical}})",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
